APP_ENV=development
APP_NAME=Enterprise Copilot
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

POSTGRES_PASSWORD=enterprise_copilot

DATABASE_URL=postgresql+psycopg://enterprise_copilot:enterprise_copilot@db:5432/enterprise_copilot
MIGRATION_DATABASE_URL=postgresql+psycopg://enterprise_copilot:enterprise_copilot@db:5432/enterprise_copilot

SESSION_COOKIE_NAME=enterprise_copilot_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_BYTES=10485760

SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

